# Backend configuration
# Copy this file to .env and fill in values when the Cloudflare backend is ready.
# Do not put secrets in source code.

# Where the Hono Worker lives. Used as the /api proxy target by `npm run dev`
# and `npm run preview`, and as the direct call target when VITE_API_MODE=direct.
VITE_API_BASE_URL=http://localhost:8787

# How the browser reaches the backend.
#   proxy  (default) - call /api on this app's own origin. The Vite dev/preview
#                      server and the Cloudflare Pages Function both forward it,
#                      which keeps the session cookie first-party.
#   direct          - call VITE_API_BASE_URL cross-site. Only correct when this
#                      app is hosted somewhere with no /api proxy, and it makes
#                      the session depend on third-party cookies being allowed.
VITE_API_MODE=proxy
