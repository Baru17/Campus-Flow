VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required for Edge Functions that use direct database access (runDb).
# Set this in Supabase Dashboard → Project Settings → Edge Functions → Environment Variables.
# Do NOT put the real database URL in source control.
SUPABASE_DB_URL=your-db-url-here